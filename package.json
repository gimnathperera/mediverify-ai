{
  "name": "mediverify-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky || true",
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** build",
    "dev:api": "pnpm --filter @mediverify/api dev",
    "dev:worker": "pnpm --filter @mediverify/worker dev",
    "dev:web": "pnpm --filter @mediverify/web dev",
    "db:migrate": "tsx --conditions=@mediverify/source scripts/migrate.ts",
    "db:seed": "tsx --conditions=@mediverify/source scripts/seed.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "eval": "tsx --conditions=@mediverify/source scripts/eval.ts",
    "eval:live": "LLM_PROVIDER=openai tsx --conditions=@mediverify/source scripts/eval.ts --live",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "9.39.5",
    "@mediverify/core": "workspace:*",
    "@mediverify/db": "workspace:*",
    "@mediverify/shared": "workspace:*",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@node-rs/argon2": "2.2.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "docx": "^9.15.3",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "16.4.0",
    "pino": "10.4.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}

# ── Copy to .env and adjust. Never commit .env. ───────────────────────────────
# LLM provider. Leave empty for automatic: 'openai' when OPENAI_API_KEY is set, otherwise 'fixture'
# (hand-authored, labelled outputs for the bundled sample only). Or set 'openai' / 'fixture' explicitly.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for reasoning models (minimal|low|medium|high); leave empty for non-reasoning models
OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=            # optional OpenAI-compatible endpoint
# Per-call timeout and retries for transient errors (429 rate limit, 5xx, network)
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=3
# Refuse any single prompt estimated above this many tokens (cost + context-window guard)
LLM_MAX_PROMPT_TOKENS=60000
# Optional USD prices per million tokens; when set, model cost is computed and shown per job
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Embeddings (local, no key needed). Downloaded at worker image build time.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Auth / sessions
SESSION_TTL_HOURS=12
# Set true when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# Self-service sign-up, on in every mode. Set false to close it (seed users still sign in); spend is
# capped by DAILY_JOB_LIMIT and GLOBAL_DAILY_JOB_LIMIT.
ALLOW_SIGNUP=
# Pipeline runs (uploads + retries) per user per rolling 24 h; 0 = unlimited. Duplicates don't count
DAILY_JOB_LIMIT=20
# Pipeline runs across all users per rolling 24 h (spend cap for a hosted demo); 0 = unlimited
GLOBAL_DAILY_JOB_LIMIT=200
# Comma-separated origins allowed to make state-changing requests (CSRF defence).
# Empty = http://localhost and http://127.0.0.1 on WEB_PORT, plus the Vite dev server (5173)
ALLOWED_ORIGINS=
# Proxy hops in front of the API (nginx = 1) so per-IP rate limits see the real client
TRUST_PROXY=1

# Upload duplicate detection window (seconds; 0 disables)
DUPLICATE_WINDOW_SECONDS=300

# Retrieval / verification
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35
# Medications verified in parallel per job (one model call each)
VERIFY_CONCURRENCY=3

# Worker / queue
# Jobs processed at once per worker container (scale out with `docker compose up --scale worker=N`)
WORKER_CONCURRENCY=1
# Per-stage time limit and attempts before a job is marked failed
STAGE_TIMEOUT_MS=180000
JOB_MAX_ATTEMPTS=3
# Input limits checked after parsing (DOCUMENT_TOO_LARGE); 0 = no limit
MAX_DOCUMENT_PAGES=50
MAX_DOCUMENT_CHARS=150000
# Retention, applied by the worker's maintenance task: progress events of finished jobs (days),
# and whole documents with their results (days; 0 = keep forever). Expired sessions are always purged.
EVENT_RETENTION_DAYS=30
DOCUMENT_RETENTION_DAYS=0

# Seed users (documented in README)
SEED_USER_EMAIL=reviewer@mediverify.test
SEED_USER_PASSWORD=Reviewer#2026
SEED_USER2_EMAIL=second.user@mediverify.test
SEED_USER2_PASSWORD=SecondUser#2026

# Host ports (the database binds to 127.0.0.1 only)
WEB_PORT=8088
DB_HOST_PORT=55432
# Database password (change for any shared deployment)
POSTGRES_PASSWORD=mediverify

# ── Advanced: defaults suit local and Compose runs; uncomment to change ─────────
# Host scripts and `pnpm dev:*` (Compose sets its own)
# DATABASE_URL=postgres://mediverify:mediverify@localhost:55432/mediverify
# LOG_LEVEL=info                  # pino level: debug | info | warn | error
# OPENAI_TEMPERATURE=             # only for models that accept it (reasoning models do not)
# Queue timing (seconds): idle poll, job lease and its heartbeat, expired-lease reaper,
# base delay of the retry backoff, and the retention/maintenance task interval
# WORKER_POLL_SECONDS=5
# JOB_LEASE_SECONDS=60
# JOB_HEARTBEAT_SECONDS=15
# REAPER_INTERVAL_SECONDS=20
# RETRY_BASE_DELAY_SECONDS=5
# MAINTENANCE_INTERVAL_SECONDS=3600
# WORKER_ID=                      # default: <hostname>-<pid>
# WORKER_HEARTBEAT_FILE=/tmp/worker.heartbeat   # touched for the container healthcheck
# SOFFICE_BIN=soffice             # LibreOffice binary for DOCX → PDF
# Embedding model cache (default ./.model-cache); true = never download (the worker image sets it)
# EMBEDDING_CACHE_DIR=
# EMBEDDING_OFFLINE=false
# Fixture LLM outputs (default ./fixtures/llm). LLM_RECORD_DIR saves live model outputs there, keyed
# like fixtures. Development only: recorded files contain model output about the document.
# LLM_FIXTURE_DIR=
# LLM_RECORD_DIR=

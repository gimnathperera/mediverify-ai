# ── Copy to .env and adjust. Never commit .env. ───────────────────────────────
# LLM: 'openai' (default, real inference) or 'fixture' (hand-authored deterministic outputs for the bundled sample only)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for reasoning models (minimal|low|medium|high); leave empty for non-reasoning models
OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=            # optional OpenAI-compatible endpoint
# Per-call timeout and retries for transient errors (429 rate limit, 5xx, network)
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=3

# Embeddings (local, no key needed). Downloaded at worker image build time.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Auth / sessions
SESSION_TTL_HOURS=12
# Set true when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# Self-service sign-up. Set false for a hosted demo that uses your paid model key (seed users still work)
ALLOW_SIGNUP=true
# Pipeline runs (uploads + retries) per user per rolling 24 h; 0 = unlimited. Duplicates don't count
DAILY_JOB_LIMIT=20
# Comma-separated origins allowed to make state-changing requests (CSRF defence)
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173

# Upload duplicate detection window (seconds; 0 disables)
DUPLICATE_WINDOW_SECONDS=300

# Retrieval / verification
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35
# Medications verified in parallel per job (one model call each)
VERIFY_CONCURRENCY=3

# Worker / queue
# Jobs processed at once per worker container (scale out with `docker compose up --scale worker=N`)
WORKER_CONCURRENCY=1
# Per-stage time limit and attempts before a job is marked failed
STAGE_TIMEOUT_MS=180000
JOB_MAX_ATTEMPTS=3

# Seed users (documented in README)
SEED_USER_EMAIL=reviewer@mediverify.test
SEED_USER_PASSWORD=Reviewer#2026
SEED_USER2_EMAIL=second.user@mediverify.test
SEED_USER2_PASSWORD=SecondUser#2026

# Host ports
WEB_PORT=8088
DB_HOST_PORT=55432
